# Copy this file to .env and fill in local values.
# Never commit .env — it is gitignored.
#
# Used by the Spring Boot datasource (see application.properties).


# -------------------------------------------- #
# BDD Configuration

BDD_USER=
BDD_PASSWORD=
BDD_NAME=db_phantasmon
BDD_HOST=localhost
BDD_PORT=5432


# -------------------------------------------- #
# JWT signing (HMAC-SHA256) — use a long random value, e.g.:
#   openssl rand -base64 64

JWT_SECRET=


# -------------------------------------------- #
# Logging — one file per backend session under ./log/, 5 GiB folder cap
# (oldest files deleted first). Set to false to disable file logging
# entirely (console logging is unaffected).

LOGGING_ENABLED=true